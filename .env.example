NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
COMMERCE_SESSION_SECRET=

FORTNITE_API_BASE_URL=https://fortnite-api.com/v2

# Entrega con FN Shop (ver docs/fnshop-integracion.md).
# manual: el equipo envía a mano. fnshop: validación de IDs y envío automático.
FULFILLMENT_MODE=manual
FNSHOP_API_BASE_URL=https://fnitem.shop/api/v3/service
# La key real va SOLO en Vercel → Production. Se liga al dominio en su primer uso.
# El código nunca llama a FN Shop fuera de VERCEL_ENV=production.
FNSHOP_API_KEY=
# Local, CI y QA: respuestas simuladas. Se ignora en producción.
FNSHOP_SIMULATE=true
# Inicio del periodo pagado (la cuota se cuenta desde aquí) y límites.
FNSHOP_TERM_STARTS_AT=2026-11-12
FNSHOP_MONTHLY_LIMIT=5000
FNSHOP_DAILY_LIMIT=300
# Vacío = todas las cuentas remitentes.
FNSHOP_CATEGORY=
# Capturas diarias para la bitácora (~64 requests al mes). Apagado por defecto.
FNSHOP_LEARNING_SNAPSHOTS=false
# Sólo para desarrollo local. En producción siempre debe ser false.
ALLOW_DEMO_PROVIDERS=false

WHATSAPP_BUSINESS_NUMBER=5215619857749

CRON_SECRET=

# Alertas internas y correo de recuperación. Nunca expongas estas variables al navegador.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
RESEND_API_KEY=
EMAIL_FROM="SigfriedLootBox <hola@tudominio.com>"
